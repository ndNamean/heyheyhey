# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Your InstantDB app ID (public — safe to expose in browser)
VITE_INSTANT_APP_ID=f7ac027e-2079-41eb-8f34-aa0e4543ca71

# Floating Knowledge Assistant mode: suspended | iframe | native
# Default suspended = placeholder UI only; no Knowledge network/iframe.
VITE_KNOWLEDGE_ASSISTANT_MODE=suspended

# Custom Group Chat (Chats tab groups). Default OFF. Set 1|true|on to enable
# client UI + /api/invites groupChat* Admin actions (Hobby: folded into invites).
# VITE_GROUP_CHAT=1
# GROUP_CHAT=1

# Your Google OAuth Client ID (from Google Cloud Console)
# Used by @react-oauth/google to render the Sign in with Google button
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# InstantDB admin token — used by seed-owner script and Vercel /api/upload-photo + /api/cleanup-photos
# Generate at: https://www.instantdb.com/dash?s=admin-tokens
# Also add as INSTANT_ADMIN_TOKEN in Vercel → Settings → Environment Variables
INSTANT_ADMIN_TOKEN=YOUR_ADMIN_TOKEN_HERE

# OpenWeather API key — server-only (used by /api/weather/current on Vercel)
# Add as OPENWEATHER_API_KEY in Vercel → Settings → Environment Variables, then redeploy.
# Note: npm run dev does NOT serve /api/* routes; use npx vercel dev or test on deployed preview.
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# Store Chat translation — server-only (/api/translate-store-chat).
# Leave unset to keep Translate feature-flagged off. Never put provider secrets in VITE_*.
# Default working provider: mymemory (keyless). Optional TRANSLATION_API_KEY = contact email for quota.
# TRANSLATION_PROVIDER=mymemory
# TRANSLATION_API_KEY=
# VITE_STORE_CHAT_TRANSLATION=1

# Store Chat GIPHY picker — client-side search key (GIPHY requires browser calls).
# Leave unset to hide the media picker. Create a key at https://developers.giphy.com/
# Rating defaults to pg in src/lib/giphyClient.ts. Attribution ("Powered by GIPHY") is required.
# Also set VITE_GIPHY_API_KEY in Vercel → Environment Variables, then redeploy.
# VITE_GIPHY_API_KEY=YOUR_GIPHY_API_KEY_HERE

# Logbook Inbox + Store Chat delivery. Missing/empty is enabled; use 0, false, or off
# to roll back Store Chat writes while retaining Admin SDK inbox and push delivery.
# All-store ack notes (storeId '') fan out one logbook_system message per recipient-linked
# active store room; single-store entries still post to that room only. Each room message
# uses @all (mentionAll). Inbox/push stay one personal notify per ack recipient (no per-room push).
# VITE_LOGBOOK_CHAT_NOTIFY=1
# LOGBOOK_CHAT_NOTIFY=1

# Web Push (VAPID) — server-only. Never put the private key in VITE_* or client code.
# Generate: npx web-push generate-vapid-keys
# Also set these on Vercel → Settings → Environment Variables, then redeploy.
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:ops@example.com

# Knowledge Assistant mode: suspended (default) | iframe | native
# Suspended = placeholder UI only; no AI/iframe/network from the Knowledge tab.
# VITE_KNOWLEDGE_ASSISTANT_MODE=suspended
